# Docker Environment Variables for Production / Development
# Copy this to .env inside the docker/ directory

# Relational Database Connection (PostgreSQL container or Supabase cloud)
DATABASE_URL=postgresql://postgres:postgres@db:5432/enterprise_rag

# Qdrant Vector DB (Local container default or Qdrant Cloud)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=enterprise_docs
# QDRANT_URL=https://your-cluster-id.us-east-4-0.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-cloud-api-key

# ── Ollama Cloud (production / Docker deployment) ────────────────────────────
# Get your API key from https://ollama.com/settings/keys
OLLAMA_BASE_URL=https://api.ollama.com
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_API_KEY=your-ollama-cloud-api-key-here

# ── Ollama Local (running locally without Docker) ─────────────────────────────
# Comment the cloud block above and uncomment these when running locally:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b
# (no OLLAMA_API_KEY needed for local)

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Authentication Security
JWT_SECRET_KEY=generate-a-strong-secret-key-here-for-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend CORS
CORS_ORIGINS=http://localhost:3000
