# ============================================================
# Frontend Dockerfile - Enterprise RAG Platform
# Multi-stage: Node (Vite build) → Nginx (production serve)
# Build context: project root (e:\enterprise-rag)
# Image: ajup738/neroxaai-frontend
# ============================================================

# ---- Stage 1: Build ----
FROM node:20-alpine AS builder

WORKDIR /app

# Layer cache: install deps before copying all source
COPY frontend/package*.json ./
RUN npm ci --silent

# Copy frontend source and build
COPY frontend/ ./
RUN npm run build

# ---- Stage 2: Serve with Nginx ----
FROM nginx:alpine AS runtime

# Copy Vite build output
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom Nginx config (SPA routing + API proxy)
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost/nginx-health || exit 1

CMD ["nginx", "-g", "daemon off;"]
