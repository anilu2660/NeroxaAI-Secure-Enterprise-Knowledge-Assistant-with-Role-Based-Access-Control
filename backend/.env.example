# ========================
# Enterprise RAG - Environment Variables
# ========================

# Application
DEBUG=true
APP_NAME=Enterprise RAG
APP_VERSION=0.1.0

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_rag

# Qdrant Vector Database
QDRANT_URL=https://your-cluster-id.us-east-4-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-cloud-api-key-here
QDRANT_COLLECTION=enterprise_docs

# JWT Authentication
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Browser Session Cookies
COOKIE_SECURE=false

# OAuth Social Logins
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
OAUTH_STATE_EXPIRE_SECONDS=600
OAUTH_SECURE_COOKIES=false
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common

# SerpApi Web Search
SERPAPI_KEY=your-serpapi-api-key
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=10
WEB_SEARCH_LOCATION=Mumbai, Maharashtra, India
WEB_SEARCH_LANGUAGE=en
WEB_SEARCH_COUNTRY=in

# Redis Semantic Cache
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_TIMEOUT_SECONDS=2
CACHE_NAMESPACE=neroxaai:v1
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES_PER_SCOPE=50

# Ollama LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Document Processing
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_UPLOAD_SIZE_MB=10

# CORS
CORS_ORIGINS=http://localhost:3000
